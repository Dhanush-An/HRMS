{
    "version": 2,
    "functions": {
        "api/index.js": {
            "memory": 1024,
            "maxDuration": 10,
            "includeFiles": "backend/data/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)\\.(css|js|png|jpg|jpeg|svg|ico|json)",
            "destination": "/frontend/dist/$1.$2"
        },
        {
            "source": "/((?!api/.*).*)",
            "destination": "/frontend/dist/index.html"
        }
    ]
}